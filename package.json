{
  "name": "studybible",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Catholic Bible study app: Scripture, Church teaching, the Fathers, Bible in a Year, notes and prayer in one library.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "data:fetch": "tsx scripts/ingest/cli.ts fetch",
    "data:build": "tsx scripts/ingest/cli.ts build",
    "data:validate": "tsx scripts/ingest/cli.ts validate",
    "data:all": "tsx scripts/ingest/cli.ts all",
    "verify:ccc": "tsx scripts/verify/ccc.ts",
    "docs:status": "tsx scripts/docs-status.ts",
    "server": "tsx server/index.ts",
    "server:dev": "tsx watch server/index.ts",
    "start": "npm run build && tsx server/index.ts",
    "admin": "tsx server/admin.ts",
    "e2e": "node e2e/smoke.mjs",
    "budget": "tsx scripts/verify/budget.ts",
    "e2e:a11y": "node e2e/a11y.mjs",
    "verify:links": "tsx scripts/verify/links.ts --sample 200"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "d3-force": "^3.0.0",
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^1.1.7",
    "dompurify": "^3.2.4",
    "leaflet": "^1.9.4",
    "marked": "^15.0.7",
    "minisearch": "^7.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/dompurify": "^3.0.5",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.14.0",
    "fake-indexeddb": "^6.2.6",
    "fast-xml-parser": "^4.5.1",
    "fflate": "^0.8.2",
    "playwright": "^1.56.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.0.5"
  }
}
